{
  "name": "minerva-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/entrypoints/local.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/entrypoints/local.ts",
    "start": "node dist/entrypoints/local.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dynamodb:up": "tsx scripts/dynamodb-local.ts up",
    "dynamodb:down": "tsx scripts/dynamodb-local.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.1156.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1156.0",
    "@aws-sdk/client-bedrock-data-automation-runtime": "^3.1156.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1159.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/aws-lambda": "^4.1.0",
    "ajv": "^8.20.0",
    "fastify": "^5.1.0",
    "jose": "^6.2.13",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^26.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
